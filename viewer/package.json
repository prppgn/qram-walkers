{
  "name": "qram-walkers-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web viewer of qramsim trajectories (quantum-walker qRAM, arXiv:2508.02855)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:static": "node scripts/build-static.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:static": "playwright test --config playwright.static.config.ts"
  },
  "dependencies": {
    "katex": "0.16.11",
    "marked": "14.1.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/katex": "0.16.7",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  }
}
